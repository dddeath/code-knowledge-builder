+HTML = """<!doctype html>
+<html>
+<head><style>.hidden { display:none }</style><script>window.secret='noise'</script></head>
+<body>
+<header>站点标题</header>
+<nav>导航噪声</nav>
+<main>
+<h1>许可可追溯快照</h1>
+<p>正文结论可由归档 HTML 的精确行范围复核。</p>
+<div role="navigation">角色导航噪声</div>
