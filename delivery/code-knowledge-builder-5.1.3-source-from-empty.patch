+def _utf8_prefix(value: str, maximum_bytes: int) -> str:
+    if maximum_bytes <= 0:
+        return ""
+    data = value.encode("utf-8")[:maximum_bytes]
+    while data:
+        try:
+            return data.decode("utf-8")
+        except UnicodeDecodeError as exc:
+            data = data[: exc.start]
+    return ""
+
