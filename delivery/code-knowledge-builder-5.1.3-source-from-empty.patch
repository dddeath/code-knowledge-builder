+HUMAN_TITLE_PREFIXES = ("实体 ·", "文件 ·", "模块 ·", "仓库 ·", "边界 ·")
+HUMAN_VISIBLE_FORBIDDEN = (
+    "Git commit",
+    "仓库 commit",
+    "Graphify commit",
