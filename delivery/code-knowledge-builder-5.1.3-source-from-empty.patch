+def _runtime_bin_candidates() -> list[Path]:
+    root = private_runtime_root()
+    if not root.is_dir():
+        return []
+    result: list[Path] = []
+    for lock_dir in sorted(root.iterdir(), reverse=True):
+        for rel in ("bin", "node", "python", "llvm/bin", "logseq", "dotnet", "dotnet-tools"):
+            path = lock_dir / rel
+            if path.is_dir():
+                result.append(path)
+    return result
