+        "WHERE d.source_entity_id IS NOT NULL ORDER BY d.source_entity_id,s.ordinal"
+    ):
+        sections[row["source_entity_id"]].append(dict(row))
+    adjacency, degree = _adjacency(connection)
+    value = {
+        "metadata_rows": metadata_rows,
