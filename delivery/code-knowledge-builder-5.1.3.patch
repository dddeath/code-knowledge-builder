+        "sections": dict(sections),
+        "adjacency": adjacency,
+        "degree": degree,
+        "linker": SourceLinkRenderer(_openers(output), trusted_relative_paths=True),
+        "entity_columns": entity_columns,
+    }
+    _RETRIEVAL_STATIC_CACHE.clear()
+    _RETRIEVAL_STATIC_CACHE[key] = value
+    return value
+
