+++ b/src/features/selection-learning/DailyLearningNoteStore.ts
@@ -0,0 +1,70 @@
+import { type App, normalizePath, TFile } from 'obsidian';
+
+import {
+  createDailyLearningDocument,
+  formatLocalDate,
+  type LearningNoteEntry,
+  renderLearningNoteEntry,
+} from './LearningNoteDocument';
+
+const LEARNING_FOLDER = '学习笔记';
+
+export class DailyLearningNoteStore {
+  private writeTail: Promise<void> = Promise.resolve();
+
+  constructor(private readonly app: App) {}
+
+  pathFor(date: Date): string {
+    return normalizePath(`${LEARNING_FOLDER}/${formatLocalDate(date)}.md`);
+  }
+
+  async append(entry: LearningNoteEntry): Promise<TFile> {
+    let written: TFile | null = null;
+    const operation = this.writeTail.then(async () => {
+      await this.ensureFolder(LEARNING_FOLDER);
+      const path = this.pathFor(entry.createdAt);
+      const existing = this.app.vault.getAbstractFileByPath(path);
+      const block = renderLearningNoteEntry(entry);
+      if (existing) {
+        if (!(existing instanceof TFile) || existing.extension !== 'md') {
+          throw new Error(`Learning note path is not a Markdown file: ${path}`);
+        }
+        await this.app.vault.process(existing, current => (
+          `${current.trimEnd()}\n\n${block}`
+        ));
+        written = existing;
+        return;
+      }
+      written = await this.app.vault.create(
+        path,
+        `${createDailyLearningDocument(entry.createdAt)}${block}`,
+      );
+    });
+    this.writeTail = operation.then(() => undefined, () => undefined);
+    await operation;
+    if (!written) {
+      throw new Error('Daily learning note write completed without a file.');
+    }
+    return written;
+  }
+
+  async open(date = new Date()): Promise<void> {
+    const path = this.pathFor(date);
+    const file = this.app.vault.getAbstractFileByPath(path);
+    if (!(file instanceof TFile) || file.extension !== 'md') {
+      throw new Error(`Today's learning note does not exist: ${path}`);
+    }
+    await this.app.workspace.getLeaf(true).openFile(file);
+  }
+
+  private async ensureFolder(path: string): Promise<void> {
+    const parts = normalizePath(path).split('/').filter(Boolean);
+    let current = '';
+    for (const part of parts) {
+      current = current ? `${current}/${part}` : part;
+      if (!this.app.vault.getAbstractFileByPath(current)) {
+        await this.app.vault.createFolder(current);
+      }
+    }
+  }
+}
diff --git a/src/features/selection-learning/LearningNoteDocument.ts b/src/features/selection-learning/LearningNoteDocument.ts
new file mode 100644
index 00000000..eeefa071
--- /dev/null
+++ b/src/features/selection-learning/LearningNoteDocument.ts
@@ -0,0 +1,85 @@
+export interface LearningNoteEntry {
+  createdAt: Date;
+  endLine?: number;
+  explanation: string;
+  followUp?: boolean;
+  parentQuestion?: string;
+  providerLabel: string;
+  question: string;
+  selectedText: string;
+  sourcePath: string;
+  sourceTitle: string;
+  startLine?: number;
+}
+
+export function formatLocalDate(value: Date): string {
+  const year = value.getFullYear();
+  const month = String(value.getMonth() + 1).padStart(2, '0');
+  const day = String(value.getDate()).padStart(2, '0');
+  return `${year}-${month}-${day}`;
+}
+
+function formatLocalTime(value: Date): string {
+  return [value.getHours(), value.getMinutes(), value.getSeconds()]
+    .map(part => String(part).padStart(2, '0'))
+    .join(':');
+}
+
+function quoteMarkdown(value: string): string {
+  return value
+    .trim()
+    .split('\n')
+    .map(line => `> ${line}`)
+    .join('\n');
+}
+
+function sourceLink(path: string, title: string): string {
+  const target = path.replace(/\.md$/i, '').replace(/\|/g, '\\|');
+  const alias = title.replace(/\|/g, '\\|');
+  return `[[${target}|${alias}]]`;
+}
+
+export function createDailyLearningDocument(date: Date): string {
+  const day = formatLocalDate(date);
+  return [
+    `# ${day} 学习笔记`,
+    '',
+    '标签：#类型/学习',
+    '',
+    '> 本页汇总当天从文档选区发起的概念提问与解释。',
+    '',
+  ].join('\n');
+}
+
+export function renderLearningNoteEntry(entry: LearningNoteEntry): string {
+  const lineRange = entry.startLine === undefined || entry.endLine === undefined
+    ? '阅览模式选中文本'
+    : entry.startLine === entry.endLine
+      ? `第 ${entry.startLine} 行`
+      : `第 ${entry.startLine}–${entry.endLine} 行`;
+  const lines = [
+    `## ${formatLocalTime(entry.createdAt)} · ${entry.followUp ? '追问 · ' : ''}${entry.sourceTitle}`,
+    '',
+    `来源：${sourceLink(entry.sourcePath, entry.sourceTitle)} · ${lineRange}`,
+    '',
+    `执行器：${entry.providerLabel}`,
+    '',
+  ];
+  if (entry.followUp && entry.parentQuestion) {
+    lines.push('### 承接问题', '', entry.parentQuestion.trim(), '');
+  }
+  lines.push(
+    entry.followUp ? '### 我的追问' : '### 我的问题',
+    '', entry.question.trim(), '',
+  );
+  if (!entry.followUp) {
+    lines.push('### 选中文本', '', quoteMarkdown(entry.selectedText), '');
+  }
+  lines.push(
+    '### 解释',
+    '',
+    entry.explanation.trim(),
+    '',
+  );
+  return lines.join('\n');
+}
