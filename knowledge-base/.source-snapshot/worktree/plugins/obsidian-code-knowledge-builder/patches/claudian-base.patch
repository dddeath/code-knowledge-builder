+import { mergeWslEnvironmentPassThrough } from '@/providers/codex/runtime/codexAppServerSupport';
+
+describe('mergeWslEnvironmentPassThrough', () => {
+  it('passes custom Codex variables into WSL without replacing the Linux PATH', () => {
+    expect(mergeWslEnvironmentPassThrough(
+      'EXISTING/u:CODEX_HOME/up',
+      {
+        CODEX_HOME: '/home/agent/.codex',
+        OPENAI_API_KEY: 'token',
+        PATH: 'C:\\tools',
+        WSLENV: 'ignored',
+      },
+    )).toBe('EXISTING/u:CODEX_HOME:OPENAI_API_KEY');
+  });
+
+  it('preserves WSL path translation for an explicitly configured Windows path', () => {
+    expect(mergeWslEnvironmentPassThrough('CODEX_HOME/p', {
+      CODEX_HOME: 'C:\\Users\\agent\\.codex',
+    })).toBe('CODEX_HOME/p');
+  });
+
+  it('creates a stable sorted pass-through list when WSLENV is absent', () => {
+    expect(mergeWslEnvironmentPassThrough(undefined, {
+      OPENAI_BASE_URL: 'https://example.invalid/v1',
+      CODEX_HOME: '/home/agent/.codex',
+    })).toBe('CODEX_HOME:OPENAI_BASE_URL');
+  });
+});
