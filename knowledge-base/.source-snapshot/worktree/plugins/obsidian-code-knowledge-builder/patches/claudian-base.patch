+export type SelectionLearningStage =
+  | 'waiting-question'
+  | 'retrieving'
+  | 'initializing-provider'
+  | 'generating'
+  | 'validating'
+  | 'writing'
+  | 'completed'
+  | 'failed'
+  | 'cancelled';
+
+export type SelectionLearningStatus =
+  | 'waiting'
+  | 'running'
+  | 'passed'
+  | 'failed'
+  | 'cancelled';
+
+export interface SelectionLearningTimelineEntry {
+  at: number;
+  message: string;
+  stage: SelectionLearningStage;
+}
+
+export interface SelectionLearningProgressSnapshot {
+  explanation: string;
+  finishedAt?: number;
+  message: string;
+  outputPath?: string;
+  providerLabel?: string;
+  question?: string;
+  retrievalPack?: string;
+  retrievalRequestId?: string;
+  selectedText: string;
+  sourcePath: string;
+  sourceTitle: string;
+  stage: SelectionLearningStage;
+  startedAt: number;
+  status: SelectionLearningStatus;
+  timeline: readonly SelectionLearningTimelineEntry[];
+}
+
+const EXPLANATION_START = '---CKB_EXPLANATION---';
+const EXPLANATION_END = '---END_CKB_EXPLANATION---';
+
+export function extractExplanationProgress(value: string): string {
+  const start = value.indexOf(EXPLANATION_START);
+  if (start < 0) return '';
+  const bodyStart = start + EXPLANATION_START.length;
+  const end = value.indexOf(EXPLANATION_END, bodyStart);
+  return value.slice(bodyStart, end < 0 ? undefined : end).trim();
+}
diff --git a/src/features/selection-learning/SelectionLearningProvider.ts b/src/features/selection-learning/SelectionLearningProvider.ts
