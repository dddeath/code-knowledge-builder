+import {
+  findProviderModelOption,
+  resolveNewConversationModel,
+  resolveProviderDefaultModel,
+} from '../../core/providers/conversationModel';
+import { ProviderRegistry } from '../../core/providers/ProviderRegistry';
+import type { ProviderId } from '../../core/providers/types';
+
+export const FOLLOW_DEFAULT_SELECTION_PROVIDER = 'follow-default';
+
+export interface SelectionLearningProviderContext {
+  modelOverride?: string;
+  providerId: ProviderId;
+  source: 'default-model' | 'fixed-provider';
+}
+
+function storedPreference(settings: Record<string, unknown>): string {
+  return typeof settings.selectionLearningProvider === 'string'
+    ? settings.selectionLearningProvider.trim()
+    : '';
+}
+
+export function normalizeSelectionLearningProvider(
+  settings: Record<string, unknown>,
+): string {
+  const preference = storedPreference(settings);
+  if (
+    preference !== FOLLOW_DEFAULT_SELECTION_PROVIDER
+    && ProviderRegistry.getRegisteredProviderIds().includes(preference)
+    && ProviderRegistry.isEnabled(preference, settings)
+  ) {
+    return preference;
+  }
+  return FOLLOW_DEFAULT_SELECTION_PROVIDER;
+}
+
+function fixedProviderModel(
+  providerId: ProviderId,
+  settings: Record<string, unknown>,
+): string | undefined {
+  const savedProviderModel = settings.savedProviderModel;
+  const savedModel = savedProviderModel
+    && typeof savedProviderModel === 'object'
+    && !Array.isArray(savedProviderModel)
+    && typeof (savedProviderModel as Record<string, unknown>)[providerId] === 'string'
+    ? ((savedProviderModel as Record<string, string>)[providerId] ?? '').trim()
+    : '';
+  if (savedModel) {
+    const availableModel = findProviderModelOption(providerId, savedModel, settings);
+    if (availableModel) return availableModel;
+  }
+  return resolveProviderDefaultModel(providerId, settings) ?? undefined;
+}
+
+export function resolveSelectionLearningProviderContext(
+  settings: Record<string, unknown>,
+): SelectionLearningProviderContext {
+  const preference = normalizeSelectionLearningProvider(settings);
+  if (preference !== FOLLOW_DEFAULT_SELECTION_PROVIDER) {
+    return {
+      modelOverride: fixedProviderModel(preference, settings),
+      providerId: preference,
+      source: 'fixed-provider',
+    };
+  }
+
+  const defaultSelection = resolveNewConversationModel(settings);
+  if (defaultSelection) {
+    return {
+      modelOverride: defaultSelection.model,
+      providerId: defaultSelection.providerId,
+      source: 'default-model',
+    };
+  }
+
+  const providerId = ProviderRegistry.resolveSettingsProviderId(settings);
+  return {
+    modelOverride: resolveProviderDefaultModel(providerId, settings) ?? undefined,
+    providerId,
+    source: 'default-model',
+  };
+}
+
+export function formatSelectionLearningProviderContext(
+  context: SelectionLearningProviderContext,
+): string {
+  const provider = ProviderRegistry.getProviderDisplayName(context.providerId);
+  return context.modelOverride ? `${provider} / ${context.modelOverride}` : provider;
+}
diff --git a/src/features/selection-learning/SelectionLearningService.ts b/src/features/selection-learning/SelectionLearningService.ts
new file mode 100644
index 00000000..6f6bd8ae
--- /dev/null
+++ b/src/features/selection-learning/SelectionLearningService.ts
@@ -0,0 +1,644 @@
+import { readFile, stat } from 'node:fs/promises';
+import path from 'node:path';
+
+import type { Editor, MarkdownView, TFile } from 'obsidian';
+import { Notice } from 'obsidian';
+
+import type { ProviderHost } from '../../core/providers/ProviderHost';
+import { ProviderRegistry } from '../../core/providers/ProviderRegistry';
+import { ProviderWorkspaceRegistry } from '../../core/providers/ProviderWorkspaceRegistry';
+import type { InlineEditService } from '../../core/providers/types';
+import { type CkbStdioClient, type CkbStdioRetrieval, utf8SafeText } from './CkbStdioClient';
+import { DailyLearningNoteStore } from './DailyLearningNoteStore';
+import { formatLocalDate } from './LearningNoteDocument';
+import { extractExplanationProgress } from './SelectionLearningProgress';
+import {
+  formatSelectionLearningProviderContext,
+  resolveSelectionLearningProviderContext,
+} from './SelectionLearningProvider';
+import type { SelectionLearningViewController } from './SelectionLearningView';
+import { SelectionQuestionModal } from './SelectionQuestionModal';
+
+export interface AuditedExplanation {
+  agentPolicyAuditReference: string;
+  evidenceReference: string;
+  explanation: string;
+  feedbackAuditReference: string;
+  stdioPack: string;
+  stdioRequestId: string;
+}
+
+interface GeneratedExplanation {
+  explanation: string;
+  stdioPack: string;
+  stdioRequestId: string;
+}
+
+interface SelectionContext {
+  endLine?: number;
+  selectedText: string;
+  sourcePath: string;
+  sourceTitle: string;
+  startLine?: number;
+}
+
+interface FollowUpState {
+  context: SelectionContext;
+  explanation: string;
+  providerLabel: string;
+  question: string;
+  service: InlineEditService;
+}
+
+const EXPLANATION_START = '---CKB_EXPLANATION---';
+const EXPLANATION_END = '---END_CKB_EXPLANATION---';
+const CKB_PRODUCT_NAME = 'CKB';
+const EXPLANATION_TIMEOUT_MS = 5 * 60 * 1_000;
+const TERMINAL_NOTICE_MS = 30_000;
+
+async function withTimeout<T>(
+  promise: Promise<T>,
+  timeoutMs: number,
+  onTimeout: () => void,
+): Promise<T> {
+  let timer: number | undefined;
+  const timeout = new Promise<never>((_resolve, reject) => {
+    timer = window.setTimeout(() => {
+      onTimeout();
+      reject(new Error(`解释执行超过 ${Math.round(timeoutMs / 60_000)} 分钟，已终止。`));
+    }, timeoutMs);
+  });
+  try {
+    return await Promise.race([promise, timeout]);
+  } finally {
+    if (timer !== undefined) window.clearTimeout(timer);
+  }
+}
+
+export function buildSelectionLearningInstruction(
+  question: string,
+  date: Date = new Date(),
+  retrieval: CkbStdioRetrieval,
+): string {
+  const day = formatLocalDate(date);
+  return [
+    '这是 CKB 选区解释快速路径。插件已经完成确定性知识库检索；只根据下方 Agent pack 与选中文本生成解释。',
+    '禁止调用任何工具、Shell、grep、ripgrep、文件读取、Skill 或子 Agent；记录和审计由插件随后通过同一 CKB stdio 进程确定性完成。',
+    '',
+    `CKB stdio 请求：${retrieval.requestId}`,
+    `Agent pack 路径：${retrieval.pack}`,
+    `最终解释只写入：学习笔记/${day}.md；不得创建 analysis 页面。`,
+    '',
+    '---CKB_AGENT_PACK---',
+    retrieval.packText,
+    '---END_CKB_AGENT_PACK---',
+    '',
+    '解释应直接面向正在学习该文档的人，先给出核心含义，再说明它在当前上下文中的作用、容易混淆的边界，并给出一个必要的简短例子。',
+    '解释字段只放最终正文，不改写选中文本，不返回 replacement 或 insertion 标签。',
+    '',
+    `问题：${utf8SafeText(question).trim()}`,
+    '',
+    '严格使用以下返回形状，不添加其他文字：',
+    'CKB_RETRIEVAL: passed',
+    'CKB_GENERATION: passed',
+    `CKB_STDIO_REQUEST: ${retrieval.requestId}`,
+    `CKB_STDIO_PACK: ${retrieval.pack}`,
+    EXPLANATION_START,
+    '<通过知识库审计的简体中文解释>',
+    EXPLANATION_END,
+  ].join('\n');
+}
+
+export function buildSelectionFollowUpInstruction(
+  question: string,
+  retrieval: CkbStdioRetrieval,
+  parentQuestion: string,
+  parentExplanation: string,
+): string {
+  return [
+    '这是 CKB 选区解释追问。保持同一 Provider 会话，但本轮必须只依据新的 Agent pack 和既有对话上下文回答。',
+    '禁止调用任何工具、Shell、grep、ripgrep、文件读取、Skill 或子 Agent；本轮记录和审计仍由同一 CKB stdio 进程完成。',
+    '追问答案只追加到当天学习笔记，不得创建 analysis 页面。',
+    '',
+    `CKB stdio 请求：${retrieval.requestId}`,
+    `Agent pack 路径：${retrieval.pack}`,
+    '',
+    '---CKB_AGENT_PACK---',
+    retrieval.packText,
+    '---END_CKB_AGENT_PACK---',
+    '',
+    `承接问题：${utf8SafeText(parentQuestion).trim()}`,
+    `上一轮解释：${utf8SafeText(parentExplanation).trim().slice(0, 4_000)}`,
+    `本轮追问：${utf8SafeText(question).trim()}`,
+    '',
+    '直接回答追问，并明确它与上一轮解释的关系；不要重复整段初始解释。',
+    '严格使用以下返回形状，不添加其他文字：',
+    'CKB_RETRIEVAL: passed',
+    'CKB_GENERATION: passed',
+    `CKB_STDIO_REQUEST: ${retrieval.requestId}`,
+    `CKB_STDIO_PACK: ${retrieval.pack}`,
+    EXPLANATION_START,
+    '<通过知识库审计的简体中文追问答案>',
+    EXPLANATION_END,
+  ].join('\n');
+}
+
+export function parseAuditedExplanation(value: string): AuditedExplanation | null {
+  const generated = parseGeneratedExplanation(value);
+  if (!generated) return null;
+  return {
+    agentPolicyAuditReference: '',
+    evidenceReference: '',
+    explanation: generated.explanation,
+    feedbackAuditReference: '',
+    stdioPack: generated.stdioPack,
+    stdioRequestId: generated.stdioRequestId,
+  };
+}
+
+function parseGeneratedExplanation(value: string): GeneratedExplanation | null {
+  const normalized = value.trim();
+  const requiredMarkers = [
+    'CKB_RETRIEVAL: passed',
+    'CKB_GENERATION: passed',
+  ];
+  if (!requiredMarkers.every(marker => normalized.includes(marker))) return null;
+  const stdioRequestId = normalized.match(/^CKB_STDIO_REQUEST:\s*(.+)$/m)?.[1]?.trim() ?? '';
+  const stdioPack = normalized.match(/^CKB_STDIO_PACK:\s*(.+)$/m)?.[1]?.trim() ?? '';
+  if (!stdioRequestId || !stdioPack) return null;
+  const start = normalized.indexOf(EXPLANATION_START);
+  const end = normalized.indexOf(EXPLANATION_END);
+  if (start < 0 || end <= start) return null;
+  const explanation = normalized.slice(start + EXPLANATION_START.length, end).trim();
+  if (!explanation) return null;
+  return {
+    explanation,
+    stdioPack,
+    stdioRequestId,
+  };
+}
+
+function outputRootForEvidence(evidencePath: string): string | null {
+  const normalized = path.resolve(evidencePath);
+  const folded = normalized.toLocaleLowerCase();
+  const marker = `${path.sep}workspace-meta${path.sep}stdio${path.sep}explanations${path.sep}`;
+  const index = folded.lastIndexOf(marker);
+  return index < 0 ? null : normalized.slice(0, index);
+}
+
+function samePath(left: string, right: string): boolean {
+  return path.resolve(left).toLocaleLowerCase() === path.resolve(right).toLocaleLowerCase();
+}
+
+async function readPassedAudit(auditPath: string, notBefore: number): Promise<void> {
+  const info = await stat(auditPath);
+  if (!info.isFile() || info.mtimeMs < notBefore) {
+    throw new Error(`CKB 审计文件不属于本次请求：${auditPath}`);
+  }
+  const audit = JSON.parse(await readFile(auditPath, 'utf8')) as {
+    errors?: unknown[];
+    status?: string;
+  };
+  if (audit.status !== 'passed' || (audit.errors?.length ?? 0) > 0) {
+    throw new Error(`CKB 审计状态未通过：${auditPath}`);
+  }
+}
+
+export async function validateCkbEvidence(
+  evidence: AuditedExplanation,
+  startedAt: number,
+  retrieval: CkbStdioRetrieval,
+): Promise<void> {
+  const evidencePath = path.resolve(evidence.evidenceReference);
+  const outputRoot = outputRootForEvidence(evidencePath);
+  if (!outputRoot) throw new Error('CKB 解释证据不在 workspace-meta/stdio/explanations 中。');
+  const evidenceInfo = await stat(evidencePath);
+  const notBefore = startedAt - 5_000;
+  if (!evidenceInfo.isFile() || evidenceInfo.mtimeMs < notBefore) {
+    throw new Error(`CKB 解释证据不属于本次请求：${evidencePath}`);
+  }
+  if (evidence.stdioRequestId !== retrieval.requestId || !samePath(evidence.stdioPack, retrieval.pack)) {
+    throw new Error('Agent 返回的 CKB stdio 请求与插件实际检索不一致。');
+  }
+  if (!samePath(outputRoot, retrieval.outputRoot)) {
+    throw new Error('CKB stdio Agent pack 与解释证据不属于同一知识库。');
+  }
+  const evidenceRecord = JSON.parse(await readFile(evidencePath, 'utf8')) as {
+    kind?: string;
+    pack?: string;
+    retrieval_request_id?: string;
+    status?: string;
+  };
+  if (
+    evidenceRecord.status !== 'passed'
+    || evidenceRecord.kind !== 'learning-explanation-evidence'
+    || evidenceRecord.retrieval_request_id !== retrieval.requestId
+    || typeof evidenceRecord.pack !== 'string'
+    || !samePath(evidenceRecord.pack, retrieval.pack)
+  ) {
+    throw new Error('CKB 解释证据内容与本次检索不一致。');
+  }
+  const packInfo = await stat(retrieval.pack);
+  if (!packInfo.isFile() || packInfo.mtimeMs < notBefore) {
+    throw new Error('CKB stdio Agent pack 不属于本次请求。');
+  }
+  const expectedFeedback = path.join(outputRoot, 'workspace-meta', 'feedback-audit.json');
+  const expectedAgentPolicy = path.join(outputRoot, 'workspace-meta', 'agent-protocol-audit.json');
+  if (!samePath(evidence.feedbackAuditReference, expectedFeedback)) {
+    throw new Error('CKB 反馈审计路径与解释证据不属于同一知识库。');
+  }
+  if (!samePath(evidence.agentPolicyAuditReference, expectedAgentPolicy)) {
+    throw new Error('CKB Agent Policy 审计路径与解释证据不属于同一知识库。');
+  }
+  await readPassedAudit(expectedFeedback, notBefore);
+  await readPassedAudit(expectedAgentPolicy, notBefore);
+}
+
+export class SelectionLearningService {
+  private activeService: InlineEditService | null = null;
+  private followUpState: FollowUpState | null = null;
+  private readonly store: DailyLearningNoteStore;
+
+  constructor(
+    private readonly plugin: ProviderHost,
+    private readonly stdio: CkbStdioClient,
+    private readonly progress: SelectionLearningViewController,
+  ) {
+    this.store = new DailyLearningNoteStore(plugin.app);
+    this.progress.setFollowUpHandler(question => this.followUp(question));
+  }
+
+  async promptAndExplain(editor: Editor, view: MarkdownView): Promise<TFile | null> {
+    const selectedText = utf8SafeText(editor.getSelection());
+    if (!selectedText.trim()) {
+      new Notice('请先在文档中选择一段文本。');
+      return null;
+    }
+    const file = view.file;
+    if (!file) {
+      new Notice('当前没有可用的 Markdown 文件。');
+      return null;
+    }
+    const from = editor.getCursor('from');
+    const to = editor.getCursor('to');
+    return this.promptContext({
+      endLine: to.line + 1,
+      selectedText,
+      sourcePath: file.path,
+      sourceTitle: file.basename,
+      startLine: from.line + 1,
+    });
+  }
+
+  async promptReadingSelection(
+    selectedText: string,
+    view: MarkdownView,
+  ): Promise<TFile | null> {
+    const normalizedText = utf8SafeText(selectedText);
+    if (!normalizedText.trim()) {
+      new Notice('请先在文档中选择一段文本。');
+      return null;
+    }
+    const file = view.file;
+    if (!file) {
+      new Notice('当前没有可用的 Markdown 文件。');
+      return null;
+    }
+    return this.promptContext({
+      selectedText: normalizedText,
+      sourcePath: file.path,
+      sourceTitle: file.basename,
+    });
+  }
+
+  private async promptContext(context: SelectionContext): Promise<TFile | null> {
+    this.releaseConversation();
+    try {
+      await this.progress.start(context);
+    } catch (error) {
+      new Notice(error instanceof Error ? error.message : String(error));
+    }
+    const preview = context.selectedText.length > 360
+      ? `${context.selectedText.slice(0, 360)}…`
+      : context.selectedText;
+    const question = await new SelectionQuestionModal(
+      this.plugin.app,
+      preview,
+    ).openAndWait();
+    if (!question) {
+      this.progress.cancel();
+      return null;
+    }
+    this.progress.setQuestion(utf8SafeText(question));
+    return this.explainAndRecord(context, utf8SafeText(question));
+  }
+
+  private async explainAndRecord(
+    context: SelectionContext,
+    question: string,
+  ): Promise<TFile | null> {
+    const startedAt = Date.now();
+    let retainConversation = false;
+    const providerContext = resolveSelectionLearningProviderContext(this.plugin.settings);
+    const providerId = providerContext.providerId;
+    const selectedText = context.selectedText;
+    const progressNotice = new Notice(`${CKB_PRODUCT_NAME} 解释：正在检索知识库……`, 0);
+    this.progress.setStage({
+      message: '正在检索知识库并生成预算化 Agent pack。',
+      stage: 'retrieving',
+      status: 'running',
+    });
+    try {
+      const retrieval = await this.stdio.retrieve([
+        question,
+        `来源文档：${context.sourcePath}`,
+        `选中文本：${selectedText}`,
+      ].join('\n'));
+      progressNotice.setMessage('CKB 解释：正在初始化模型工作区……');
+      this.progress.setStage({
+        message: '检索完成，正在初始化模型工作区。',
+        retrievalPack: retrieval.pack,
+        retrievalRequestId: retrieval.requestId,
+        stage: 'initializing-provider',
+        status: 'running',
+      });
+      await ProviderWorkspaceRegistry.ensureInitialized(
+        this.plugin,
+        providerId,
+        'selection-learning',
+      );
+      const service = ProviderRegistry.createSelectionLearningService(
+        this.plugin,
+        providerId,
+        retrieval.outputRoot,
+      );
+      service.setModelOverride?.(providerContext.modelOverride);
+      this.activeService?.cancel();
+      this.activeService = service;
+      const providerLabel = formatSelectionLearningProviderContext(providerContext);
+      progressNotice.setMessage(`CKB 解释：${providerLabel} 正在快速生成……`);
+      this.progress.setStage({
+        message: 'Provider 正在无工具模式下根据已注入的 Agent pack 生成解释。',
+        providerLabel,
+        stage: 'generating',
+        status: 'running',
+      });
+      service.setProgressCallback?.((text) => {
+        const explanation = extractExplanationProgress(text);
+        if (explanation) this.progress.streamExplanation(explanation);
+      });
+      const result = await withTimeout(
+        service.editText({
+          instruction: buildSelectionLearningInstruction(question, new Date(), retrieval),
+          lineCount: context.startLine !== undefined && context.endLine !== undefined
+            ? context.endLine - context.startLine + 1
+            : Math.max(1, selectedText.split('\n').length),
+          mode: 'selection',
+          notePath: context.sourcePath,
+          selectedText,
+          startLine: context.startLine ?? 1,
+        }),
+        EXPLANATION_TIMEOUT_MS,
+        () => service.cancel(),
+      );
+      if (!result.success) {
+        throw new Error(result.error || '执行器没有返回解释。');
+      }
+      const rawExplanation = (
+        result.clarification
+        ?? result.editedText
+        ?? result.insertedText
+        ?? ''
+      ).trim();
+      if (!rawExplanation) {
+        throw new Error('执行器返回了空解释。');
+      }
+      const generated = parseGeneratedExplanation(rawExplanation);
+      if (!generated) {
+        throw new Error('Provider 没有返回与本次检索一致的解释凭据，学习页保持不变。');
+      }
+      if (
+        generated.stdioRequestId !== retrieval.requestId
+        || !samePath(generated.stdioPack, retrieval.pack)
+      ) {
+        throw new Error('Provider 返回的 CKB stdio 请求或 Agent pack 与本次检索不一致。');
+      }
+      progressNotice.setMessage('CKB 解释：正在确定性记录并审计……');
+      this.progress.setStage({
+        message: '生成完成，正在通过同一 CKB stdio 进程记录并执行审计。',
+        stage: 'validating',
+        status: 'running',
+      });
+      const recorded = await this.stdio.recordExplanation({
+        explanation: generated.explanation,
+        idempotencyKey: `${retrieval.requestId}-record`,
+        pack: retrieval.pack,
+        question,
+        retrievalRequestId: retrieval.requestId,
+        selectedText,
+        sourcePath: context.sourcePath,
+        sourceTitle: context.sourceTitle,
+      });
+      const audited: AuditedExplanation = {
+        agentPolicyAuditReference: recorded.agentPolicyAudit,
+        evidenceReference: recorded.evidence,
+        explanation: generated.explanation,
+        feedbackAuditReference: recorded.feedbackAudit,
+        stdioPack: recorded.pack,
+        stdioRequestId: recorded.retrievalRequestId,
+      };
+      await validateCkbEvidence(audited, startedAt, retrieval);
+      progressNotice.setMessage('CKB 解释：正在写入今日学习笔记……');
+      this.progress.setStage({
+        message: '审计凭据通过，正在写入今日学习笔记。',
+        stage: 'writing',
+        status: 'running',
+      });
+      const learningFile = await this.store.append({
+        createdAt: new Date(),
+        endLine: context.endLine,
+        explanation: audited.explanation,
+        providerLabel,
+        question,
+        selectedText,
+        sourcePath: context.sourcePath,
+        sourceTitle: context.sourceTitle,
+        startLine: context.startLine,
+      });
+      progressNotice.setMessage(`CKB 解释完成：已写入 ${learningFile.path}`);
+      this.followUpState = {
+        context,
+        explanation: audited.explanation,
+        providerLabel,
+        question,
+        service,
+      };
+      retainConversation = true;
+      this.progress.complete(audited.explanation, learningFile.path);
+      window.setTimeout(() => progressNotice.hide(), TERMINAL_NOTICE_MS);
+      await this.plugin.app.workspace.getLeaf(true).openFile(learningFile);
+      return learningFile;
+    } catch (error) {
+      const message = error instanceof Error ? error.message : String(error);
+      progressNotice.setMessage(`CKB 解释失败：${message}`);
+      this.progress.fail(message);
+      window.setTimeout(() => progressNotice.hide(), TERMINAL_NOTICE_MS);
+      return null;
+    } finally {
+      this.activeService?.setProgressCallback?.(undefined);
+      if (!retainConversation) this.releaseConversation();
+    }
+  }
+
+  private async followUp(question: string): Promise<void> {
+    const state = this.followUpState;
+    const service = this.activeService;
+    if (!state || !service || state.service !== service) {
+      this.progress.fail('当前解释会话已经结束，请重新选择文本发起解释。');
+      return;
+    }
+    const startedAt = Date.now();
+    const parentQuestion = state.question;
+    const progressNotice = new Notice(`${CKB_PRODUCT_NAME} 追问：正在检索知识库……`, 0);
+    this.progress.setQuestion(`追问：${question}`);
+    this.progress.setStage({
+      explanation: '',
+      message: '正在为追问执行新的 CKB 检索。',
+      stage: 'retrieving',
+      status: 'running',
+    });
+    try {
+      const retrieval = await this.stdio.retrieve([
+        question,
+        `来源文档：${state.context.sourcePath}`,
+        `原始选中文本：${state.context.selectedText}`,
+        `承接问题：${parentQuestion}`,
+        `上一轮解释：${state.explanation.slice(0, 4_000)}`,
+      ].join('\n'));
+      this.progress.setStage({
+        message: '追问检索完成，正在复用同一 Provider 会话生成回答。',
+        providerLabel: state.providerLabel,
+        retrievalPack: retrieval.pack,
+        retrievalRequestId: retrieval.requestId,
+        stage: 'generating',
+        status: 'running',
+      });
+      progressNotice.setMessage(`CKB 追问：${state.providerLabel} 正在回答……`);
+      service.setProgressCallback?.((text) => {
+        const explanation = extractExplanationProgress(text);
+        if (explanation) this.progress.streamExplanation(explanation);
+      });
+      const result = await withTimeout(
+        service.continueConversation(
+          buildSelectionFollowUpInstruction(
+            question,
+            retrieval,
+            parentQuestion,
+            state.explanation,
+          ),
+        ),
+        EXPLANATION_TIMEOUT_MS,
+        () => service.cancel(),
+      );
+      if (!result.success) {
+        throw new Error(result.error || '执行器没有返回追问答案。');
+      }
+      const rawExplanation = (
+        result.clarification
+        ?? result.editedText
+        ?? result.insertedText
+        ?? ''
+      ).trim();
+      const generated = parseGeneratedExplanation(rawExplanation);
+      if (!generated) {
+        throw new Error('Provider 没有返回与追问检索一致的解释凭据。');
+      }
+      if (
+        generated.stdioRequestId !== retrieval.requestId
+        || !samePath(generated.stdioPack, retrieval.pack)
+      ) {
+        throw new Error('追问返回的 CKB stdio 请求或 Agent pack 与实际检索不一致。');
+      }
+      progressNotice.setMessage('CKB 追问：正在写入机器证据并审计……');
+      this.progress.setStage({
+        message: '追问生成完成，正在通过同一 CKB stdio 进程执行审计。',
+        stage: 'validating',
+        status: 'running',
+      });
+      const recorded = await this.stdio.recordExplanation({
+        explanation: generated.explanation,
+        idempotencyKey: `${retrieval.requestId}-follow-up`,
+        pack: retrieval.pack,
+        question,
+        retrievalRequestId: retrieval.requestId,
+        selectedText: state.context.selectedText,
+        sourcePath: state.context.sourcePath,
+        sourceTitle: state.context.sourceTitle,
+      });
+      const audited: AuditedExplanation = {
+        agentPolicyAuditReference: recorded.agentPolicyAudit,
+        evidenceReference: recorded.evidence,
+        explanation: generated.explanation,
+        feedbackAuditReference: recorded.feedbackAudit,
+        stdioPack: recorded.pack,
+        stdioRequestId: recorded.retrievalRequestId,
+      };
+      await validateCkbEvidence(audited, startedAt, retrieval);
+      this.progress.setStage({
+        message: '追问审计通过，正在追加到今日学习笔记。',
+        stage: 'writing',
+        status: 'running',
+      });
+      const learningFile = await this.store.append({
+        createdAt: new Date(),
+        endLine: state.context.endLine,
+        explanation: audited.explanation,
+        followUp: true,
+        parentQuestion,
+        providerLabel: state.providerLabel,
+        question,
+        selectedText: state.context.selectedText,
+        sourcePath: state.context.sourcePath,
+        sourceTitle: state.context.sourceTitle,
+        startLine: state.context.startLine,
+      });
+      this.followUpState = {
+        ...state,
+        explanation: audited.explanation,
+        question,
+      };
+      progressNotice.setMessage(`CKB 追问完成：已写入 ${learningFile.path}`);
+      this.progress.complete(audited.explanation, learningFile.path);
+      window.setTimeout(() => progressNotice.hide(), TERMINAL_NOTICE_MS);
+    } catch (error) {
+      const message = error instanceof Error ? error.message : String(error);
+      progressNotice.setMessage(`CKB 追问失败：${message}`);
+      this.progress.fail(message);
+      this.releaseConversation();
+      window.setTimeout(() => progressNotice.hide(), TERMINAL_NOTICE_MS);
+    } finally {
+      service.setProgressCallback?.(undefined);
+    }
+  }
+
+  private releaseConversation(): void {
+    this.activeService?.setProgressCallback?.(undefined);
+    this.activeService?.resetConversation();
+    this.activeService = null;
+    this.followUpState = null;
+  }
+
+  async openToday(): Promise<void> {
+    try {
+      await this.store.open();
+    } catch (error) {
+      new Notice(error instanceof Error ? error.message : String(error));
+    }
+  }
+
+  dispose(): void {
+    this.progress.setFollowUpHandler(null);
+    this.activeService?.cancel();
+    this.releaseConversation();
+  }
+}
diff --git a/src/features/selection-learning/SelectionLearningView.ts b/src/features/selection-learning/SelectionLearningView.ts
new file mode 100644
index 00000000..9dd41295
--- /dev/null
+++ b/src/features/selection-learning/SelectionLearningView.ts
@@ -0,0 +1,340 @@
+import type { App, WorkspaceLeaf } from 'obsidian';
+import { ItemView, MarkdownRenderer, setIcon, TFile } from 'obsidian';
+
+import type {
+  SelectionLearningProgressSnapshot,
+  SelectionLearningStage,
+  SelectionLearningStatus,
+  SelectionLearningTimelineEntry,
+} from './SelectionLearningProgress';
+
+export const SELECTION_LEARNING_VIEW_TYPE = 'ckb-selection-learning-view';
+
+const CKB_PRODUCT_NAME = 'CKB';
+
+export interface SelectionLearningContextSummary {
+  selectedText: string;
+  sourcePath: string;
+  sourceTitle: string;
+}
+
+interface ProgressPatch {
+  explanation?: string;
+  finishedAt?: number;
+  message: string;
+  outputPath?: string;
+  providerLabel?: string;
+  question?: string;
+  retrievalPack?: string;
+  retrievalRequestId?: string;
+  stage: SelectionLearningStage;
+  status: SelectionLearningStatus;
+}
+
+const STATUS_LABELS: Record<SelectionLearningStatus, string> = {
+  cancelled: '已取消',
+  failed: '失败',
+  passed: '已完成',
+  running: '进行中',
+  waiting: '等待提问',
+};
+
+export class SelectionLearningViewController {
+  private followUpHandler: ((question: string) => Promise<void>) | null = null;
+  private pendingExplanation = '';
+  private renderTimer: number | null = null;
+  private snapshot: SelectionLearningProgressSnapshot | null = null;
+  private readonly views = new Set<SelectionLearningView>();
+
+  constructor(private readonly app: App) {}
+
+  attach(view: SelectionLearningView): void {
+    this.views.add(view);
+    view.renderSnapshot(this.snapshot);
+  }
+
+  detach(view: SelectionLearningView): void {
+    this.views.delete(view);
+  }
+
+  setFollowUpHandler(handler: ((question: string) => Promise<void>) | null): void {
+    this.followUpHandler = handler;
+    this.publish();
+  }
+
+  canFollowUp(): boolean {
+    return this.followUpHandler !== null && this.snapshot?.status === 'passed';
+  }
+
+  async submitFollowUp(question: string): Promise<void> {
+    const normalized = question.trim();
+    if (!normalized || !this.followUpHandler || this.snapshot?.status !== 'passed') return;
+    await this.followUpHandler(normalized);
+  }
+
+  async start(context: SelectionLearningContextSummary): Promise<void> {
+    this.cancelPendingRender();
+    const now = Date.now();
+    this.snapshot = {
+      explanation: '',
+      message: '已接收选中文本，等待输入问题。',
+      selectedText: context.selectedText,
+      sourcePath: context.sourcePath,
+      sourceTitle: context.sourceTitle,
+      stage: 'waiting-question',
+      startedAt: now,
+      status: 'waiting',
+      timeline: [{ at: now, message: '等待输入问题', stage: 'waiting-question' }],
+    };
+    this.publish();
+    await this.open();
+  }
+
+  setQuestion(question: string): void {
+    if (!this.snapshot) return;
+    this.snapshot = { ...this.snapshot, question };
+    this.publish();
+  }
+
+  setStage(patch: ProgressPatch): void {
+    if (!this.snapshot) return;
+    const timeline = this.appendTimeline(this.snapshot.timeline, patch);
+    this.snapshot = {
+      ...this.snapshot,
+      ...patch,
+      timeline,
+    };
+    this.publish();
+  }
+
+  streamExplanation(explanation: string): void {
+    if (!this.snapshot || !explanation || this.snapshot.status !== 'running') return;
+    this.pendingExplanation = explanation;
+    if (this.renderTimer !== null) return;
+    this.renderTimer = window.setTimeout(() => {
+      this.renderTimer = null;
+      if (!this.snapshot || !this.pendingExplanation) return;
+      this.snapshot = { ...this.snapshot, explanation: this.pendingExplanation };
+      this.publish();
+    }, 120);
+  }
+
+  complete(explanation: string, outputPath: string): void {
+    this.cancelPendingRender();
+    this.setStage({
+      explanation,
+      finishedAt: Date.now(),
+      message: `解释已写入 ${outputPath}`,
+      outputPath,
+      stage: 'completed',
+      status: 'passed',
+    });
+  }
+
+  fail(message: string): void {
+    this.cancelPendingRender();
+    this.setStage({
+      finishedAt: Date.now(),
+      message,
+      stage: 'failed',
+      status: 'failed',
+    });
+  }
+
+  cancel(): void {
+    this.cancelPendingRender();
+    this.setStage({
+      finishedAt: Date.now(),
+      message: '已取消本次解释，知识库没有写入新内容。',
+      stage: 'cancelled',
+      status: 'cancelled',
+    });
+  }
+
+  async open(): Promise<void> {
+    const workspace = this.app.workspace;
+    const existing = workspace.getLeavesOfType(SELECTION_LEARNING_VIEW_TYPE)[0];
+    const leaf = existing ?? workspace.getRightLeaf(true);
+    if (!leaf) throw new Error('右侧 CKB 解释视图不可用。');
+    if (!existing) {
+      await leaf.setViewState({ active: true, type: SELECTION_LEARNING_VIEW_TYPE });
+    }
+    await workspace.revealLeaf(leaf);
+  }
+
+  async openPath(path: string): Promise<void> {
+    const file = this.app.vault.getAbstractFileByPath(path);
+    if (!(file instanceof TFile)) throw new Error(`知识库页面不存在：${path}`);
+    await this.app.workspace.getLeaf(true).openFile(file);
+  }
+
+  dispose(): void {
+    this.cancelPendingRender();
+    this.views.clear();
+  }
+
+  private appendTimeline(
+    timeline: readonly SelectionLearningTimelineEntry[],
+    patch: ProgressPatch,
+  ): readonly SelectionLearningTimelineEntry[] {
+    const previous = timeline.at(-1);
+    if (previous?.stage === patch.stage && previous.message === patch.message) return timeline;
+    return [...timeline, { at: Date.now(), message: patch.message, stage: patch.stage }];
+  }
+
+  private cancelPendingRender(): void {
+    if (this.renderTimer !== null) {
+      window.clearTimeout(this.renderTimer);
+      this.renderTimer = null;
+    }
+    this.pendingExplanation = '';
+  }
+
+  private publish(): void {
+    for (const view of this.views) view.renderSnapshot(this.snapshot);
+  }
+}
+
+export class SelectionLearningView extends ItemView {
+  constructor(
+    leaf: WorkspaceLeaf,
+    private readonly controller: SelectionLearningViewController,
+  ) {
+    super(leaf);
+  }
+
+  getViewType(): string {
+    return SELECTION_LEARNING_VIEW_TYPE;
+  }
+
+  getDisplayText(): string {
+    return `${CKB_PRODUCT_NAME} 解释`;
+  }
+
+  getIcon(): string {
+    return 'book-open-check';
+  }
+
+  async onOpen(): Promise<void> {
+    this.contentEl.addClass('ckb-selection-learning-view');
+    this.controller.attach(this);
+  }
+
+  async onClose(): Promise<void> {
+    this.controller.detach(this);
+  }
+
+  renderSnapshot(snapshot: SelectionLearningProgressSnapshot | null): void {
+    const root = this.contentEl;
+    root.replaceChildren();
+    const header = root.createDiv({ cls: 'ckb-selection-learning-view-header' });
+    const icon = header.createSpan({ cls: 'ckb-selection-learning-view-icon' });
+    setIcon(icon, 'book-open-check');
+    header.createEl('h3', { text: `${CKB_PRODUCT_NAME} 解释` });
+    if (!snapshot) {
+      root.createEl('p', {
+        cls: 'ckb-selection-learning-view-empty',
+        text: '选中文本后使用右键菜单，这里会显示检索、生成、审计和写入过程。',
+      });
+      return;
+    }
+
+    const status = root.createDiv({
+      cls: `ckb-selection-learning-status is-${snapshot.status}`,
+    });
+    status.createSpan({
+      cls: 'ckb-selection-learning-status-label',
+      text: STATUS_LABELS[snapshot.status],
+    });
+    status.createSpan({ text: snapshot.message });
+
+    const context = root.createDiv({ cls: 'ckb-selection-learning-context' });
+    context.createDiv({ cls: 'ckb-selection-learning-source', text: snapshot.sourceTitle });
+    context.createDiv({ cls: 'ckb-selection-learning-path', text: snapshot.sourcePath });
+    if (snapshot.question) {
+      context.createDiv({ cls: 'ckb-selection-learning-question-value', text: snapshot.question });
+    }
+    if (snapshot.providerLabel) {
+      context.createDiv({
+        cls: 'ckb-selection-learning-provider',
+        text: `执行器：${snapshot.providerLabel}`,
+      });
+    }
+    if (snapshot.retrievalRequestId && snapshot.retrievalPack) {
+      const evidence = context.createDiv({ cls: 'ckb-selection-learning-retrieval-evidence' });
+      evidence.createDiv({ text: '知识库检索证据' });
+      evidence.createDiv({
+        text: `路径：${CKB_PRODUCT_NAME} stdio · retrieve --profile fast`,
+      });
+      evidence.createDiv({ text: `请求：${snapshot.retrievalRequestId}` });
+      evidence.createDiv({ text: `Agent pack：${snapshot.retrievalPack}` });
+    }
+    const selection = context.createEl('details', { cls: 'ckb-selection-learning-selection' });
+    selection.createEl('summary', { text: '查看选中文本' });
+    selection.createEl('blockquote', { text: snapshot.selectedText });
+
+    root.createEl('h4', { text: '执行过程' });
+    const timeline = root.createEl('ol', { cls: 'ckb-selection-learning-timeline' });
+    for (const entry of snapshot.timeline) {
+      const item = timeline.createEl('li');
+      item.createEl('time', { text: formatTime(entry.at) });
+      item.createSpan({ text: entry.message });
+    }
+
+    if (snapshot.explanation) {
+      root.createEl('h4', { text: snapshot.status === 'passed' ? '解释结果' : '生成中的解释' });
+      const explanation = root.createDiv({ cls: 'ckb-selection-learning-explanation markdown-rendered' });
+      void MarkdownRenderer.render(
+        this.app,
+        snapshot.explanation,
+        explanation,
+        snapshot.sourcePath,
+        this,
+      );
+    }
+
+    if (snapshot.status === 'passed' && this.controller.canFollowUp()) {
+      const followUp = root.createDiv({ cls: 'ckb-selection-learning-follow-up' });
+      followUp.createEl('h4', { text: '继续追问' });
+      const input = followUp.createEl('textarea', {
+        attr: { placeholder: '基于当前解释继续提问；Ctrl/Cmd + Enter 提交。' },
+        cls: 'ckb-selection-learning-follow-up-input',
+      });
+      const submit = followUp.createEl('button', { text: '追问并记录' });
+      const send = () => {
+        const question = input.value.trim();
+        if (!question) return;
+        input.disabled = true;
+        submit.disabled = true;
+        void this.controller.submitFollowUp(question);
+      };
+      input.addEventListener('keydown', event => {
+        if ((event.ctrlKey || event.metaKey) && event.key === 'Enter') {
+          event.preventDefault();
+          send();
+        }
+      });
+      submit.addEventListener('click', send);
+    }
+
+    const actions = root.createDiv({ cls: 'ckb-selection-learning-view-actions' });
+    if (snapshot.outputPath) {
+      const output = actions.createEl('button', { text: '打开学习笔记' });
+      output.addEventListener('click', () => {
+        void this.controller.openPath(snapshot.outputPath ?? '');
+      });
+    }
+    const source = actions.createEl('button', { text: '打开来源页面' });
+    source.addEventListener('click', () => {
+      void this.controller.openPath(snapshot.sourcePath);
+    });
+  }
+}
+
+function formatTime(value: number): string {
+  return new Date(value).toLocaleTimeString('zh-CN', {
+    hour: '2-digit',
+    minute: '2-digit',
+    second: '2-digit',
+  });
+}
diff --git a/src/features/selection-learning/SelectionQuestionModal.ts b/src/features/selection-learning/SelectionQuestionModal.ts
new file mode 100644
index 00000000..3a985386
--- /dev/null
+++ b/src/features/selection-learning/SelectionQuestionModal.ts
@@ -0,0 +1,76 @@
+import { type App, ButtonComponent, Modal } from 'obsidian';
+
+const DEFAULT_QUESTION = '请解释这段内容中的核心概念、作用、上下文和容易误解的边界。';
+
+export class SelectionQuestionModal extends Modal {
+  private question = DEFAULT_QUESTION;
+  private resolveResult: ((value: string | null) => void) | null = null;
+
+  constructor(app: App, private readonly previewText: string) {
+    super(app);
+  }
+
+  openAndWait(): Promise<string | null> {
+    return new Promise(resolve => {
+      this.resolveResult = resolve;
+      super.open();
+    });
+  }
+
+  onOpen(): void {
+    this.contentEl.empty();
+    this.contentEl.addClass('ckb-selection-learning-modal');
+    this.contentEl.createEl('h3', { text: '询问选中文本' });
+
+    const preview = this.contentEl.createEl('pre', {
+      cls: 'ckb-selection-learning-preview',
+    });
+    preview.setText(this.previewText);
+
+    const textarea = this.contentEl.createEl('textarea', {
+      cls: 'ckb-selection-learning-question',
+    });
+    textarea.value = this.question;
+    textarea.addEventListener('input', () => {
+      this.question = textarea.value;
+    });
+    textarea.addEventListener('keydown', event => {
+      if ((event.ctrlKey || event.metaKey) && event.key === 'Enter') {
+        event.preventDefault();
+        this.submit();
+      }
+    });
+
+    const buttons = this.contentEl.createDiv({ cls: 'ckb-selection-learning-buttons' });
+    new ButtonComponent(buttons)
+      .setButtonText('取消')
+      .onClick(() => this.finish(null));
+    new ButtonComponent(buttons)
+      .setButtonText('提问并记录')
+      .setCta()
+      .onClick(() => this.submit());
+    window.setTimeout(() => textarea.focus(), 20);
+  }
+
+  onClose(): void {
+    this.contentEl.empty();
+    if (this.resolveResult) {
+      const resolve = this.resolveResult;
+      this.resolveResult = null;
+      resolve(null);
+    }
+  }
+
+  private submit(): void {
+    const question = this.question.trim();
+    if (!question) return;
+    this.finish(question);
+  }
+
+  private finish(value: string | null): void {
+    const resolve = this.resolveResult;
+    this.resolveResult = null;
+    this.close();
+    resolve?.(value);
+  }
+}
diff --git a/src/features/settings/ClaudianSettings.ts b/src/features/settings/ClaudianSettings.ts
index 48a12c07..0890b005 100644
--- a/src/features/settings/ClaudianSettings.ts
