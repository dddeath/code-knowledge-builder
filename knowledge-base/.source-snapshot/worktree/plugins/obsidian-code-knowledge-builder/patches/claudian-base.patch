+import { extractExplanationProgress } from '@/features/selection-learning/SelectionLearningProgress';
+
+describe('extractExplanationProgress', () => {
+  it('returns nothing before the audited explanation marker appears', () => {
+    expect(extractExplanationProgress('CKB_WORKFLOW_AUDIT: passed')).toBe('');
+  });
+
+  it('returns a partial explanation while the provider is still streaming', () => {
+    expect(extractExplanationProgress([
+      '---CKB_EXPLANATION---',
+      '正在生成的中文解释',
+    ].join('\n'))).toBe('正在生成的中文解释');
+  });
+
+  it('stops before the terminal marker', () => {
+    expect(extractExplanationProgress([
+      '---CKB_EXPLANATION---',
+      '最终解释',
+      '---END_CKB_EXPLANATION---',
+      'ignored',
+    ].join('\n'))).toBe('最终解释');
+  });
+
+  it('does not expose protocol fields as explanation text', () => {
+    expect(extractExplanationProgress([
+      'CKB_RECORD: E:/knowledge/record.md',
+      'CKB_AUDIT: passed',
+    ].join('\n'))).toBe('');
+  });
+});
