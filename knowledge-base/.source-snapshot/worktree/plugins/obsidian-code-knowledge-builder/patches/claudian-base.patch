+function wslEnvironmentName(entry: string): string {
+  return entry.split('/', 1)[0]?.trim().toUpperCase() ?? '';
+}
+
+export function mergeWslEnvironmentPassThrough(
+  current: string | undefined,
+  customEnv: Record<string, string>,
+): string {
+  const entries = (current ?? '').split(':').map(value => value.trim()).filter(Boolean);
+  const indexByName = new Map<string, number>();
+  entries.forEach((entry, index) => {
+    const name = wslEnvironmentName(entry);
+    if (name && !indexByName.has(name)) indexByName.set(name, index);
+  });
+  for (const key of Object.keys(customEnv).sort()) {
+    const normalized = key.trim().toUpperCase();
+    if (
+      !/^[A-Z_][A-Z0-9_]*$/.test(normalized)
+      || normalized === 'PATH'
+      || normalized === 'WSLENV'
+    ) {
+      continue;
+    }
+    const existingIndex = indexByName.get(normalized);
+    if (existingIndex !== undefined) {
+      const existing = entries[existingIndex] ?? key;
+      const flags = existing.split('/', 2)[1]?.toLowerCase() ?? '';
+      if (customEnv[key]?.startsWith('/') && flags.includes('p')) {
+        entries[existingIndex] = key;
+      }
+      continue;
+    }
+    entries.push(key);
+    indexByName.set(normalized, entries.length - 1);
+  }
+  return entries.join(':');
+}
