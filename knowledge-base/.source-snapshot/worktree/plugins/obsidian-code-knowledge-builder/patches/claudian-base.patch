diff --git a/src/features/selection-learning/CkbStdioClient.ts b/src/features/selection-learning/CkbStdioClient.ts
new file mode 100644
index 00000000..0189abfb
--- /dev/null
+++ b/src/features/selection-learning/CkbStdioClient.ts
@@ -0,0 +1,380 @@
+import { type ChildProcessWithoutNullStreams, spawn } from 'node:child_process';
+import { readFile, stat } from 'node:fs/promises';
+import path from 'node:path';
+import { createInterface, type Interface } from 'node:readline';
+
+import { type App, FileSystemAdapter } from 'obsidian';
+
+export interface CkbStdioBinding {
+  ckbScript: string;
+  outputRoot: string;
+  python: string;
+}
+
+interface CkbOutputContract {
+  contract?: unknown;
+  output?: unknown;
+  runtime?: { ckb?: unknown; python?: unknown };
+  schema_version?: unknown;
+  status?: unknown;
+  stdio?: { methods?: unknown; minimum_version?: unknown; protocol?: unknown };
+  vault?: unknown;
+}
+
+export interface CkbStdioRetrieval {
+  elapsedMs: number;
+  outputRoot: string;
+  pack: string;
+  packText: string;
+  requestId: string;
+  status: 'passed';
+}
+
+export interface CkbRecordedExplanation {
+  agentPolicyAudit: string;
+  evidence: string;
+  feedbackAudit: string;
+  pack: string;
+  retrievalRequestId: string;
+  status: 'passed';
+}
+
+export interface CkbRecordExplanationInput {
+  explanation: string;
+  idempotencyKey: string;
+  pack: string;
+  question: string;
+  retrievalRequestId: string;
+  selectedText: string;
+  sourcePath: string;
+  sourceTitle: string;
+}
+
+interface PendingRequest {
+  reject: (error: Error) => void;
+  resolve: (value: Record<string, unknown>) => void;
+  timer: number;
+}
+
+interface StdioResponse {
+  error?: { message?: string };
+  id?: string | number;
+  ok?: boolean;
+  result?: Record<string, unknown>;
+}
+
+export function utf8SafeText(value: string): string {
+  let normalized = '';
+  for (let index = 0; index < value.length; index += 1) {
+    const code = value.charCodeAt(index);
+    if (code >= 0xD800 && code <= 0xDBFF) {
+      const next = value.charCodeAt(index + 1);
+      if (next >= 0xDC00 && next <= 0xDFFF) {
+        normalized += value[index] + value[index + 1];
+        index += 1;
+      } else {
+        normalized += '\uFFFD';
+      }
+    } else if (code >= 0xDC00 && code <= 0xDFFF) {
+      normalized += '\uFFFD';
+    } else {
+      normalized += value[index];
+    }
+  }
+  return normalized;
+}
+
+async function isFile(value: string): Promise<boolean> {
+  try {
+    return (await stat(value)).isFile();
+  } catch {
+    return false;
+  }
+}
+
+export function parseCkbBinding(document: string, outputRoot: string): CkbStdioBinding | null {
+  const windows = document.match(/&\s*'([^'\r\n]*python\.exe)'\s*'([^'\r\n]*ckb\.py)'/i);
+  if (windows) {
+    return { ckbScript: windows[2], outputRoot, python: windows[1] };
+  }
+  const posix = document.match(/(?:^|\n)\s*(\S*python(?:3(?:\.\d+)?)?)\s+["']?([^"'\s]+ckb\.py)["']?/i);
+  if (posix) {
+    return { ckbScript: posix[2], outputRoot, python: posix[1] };
+  }
+  return null;
+}
+
+export function parseCkbOutputContract(document: string, vaultRoot: string): CkbStdioBinding | null {
+  let value: CkbOutputContract;
+  try {
+    value = JSON.parse(document) as CkbOutputContract;
+  } catch {
+    return null;
+  }
+  const methods = Array.isArray(value.stdio?.methods) ? value.stdio.methods : [];
+  if (
+    value.schema_version !== 1
+    || value.contract !== 'code-knowledge-builder-output'
+    || value.status !== 'ready'
+    || typeof value.output !== 'string'
+    || typeof value.vault !== 'string'
+    || typeof value.runtime?.python !== 'string'
+    || typeof value.runtime?.ckb !== 'string'
+    || value.stdio?.protocol !== 'ckb-stdio-retrieval'
+    || typeof value.stdio.minimum_version !== 'number'
+    || value.stdio.minimum_version < 2
+    || !['ping', 'retrieve', 'record-explanation', 'shutdown'].every(method => methods.includes(method))
+    || path.resolve(value.vault) !== path.resolve(vaultRoot)
+  ) {
+    return null;
+  }
+  return {
+    ckbScript: value.runtime.ckb,
+    outputRoot: path.resolve(value.output),
+    python: value.runtime.python,
+  };
+}
+
+async function discoverBinding(app: App): Promise<CkbStdioBinding> {
+  const adapter = app.vault.adapter;
+  if (!(adapter instanceof FileSystemAdapter)) {
+    throw new Error('CKB stdio 需要桌面端本地 vault。');
+  }
+  const vaultRoot = path.resolve(adapter.getBasePath());
+  const outputContract = path.join(vaultRoot, '.ckb', 'output-contract.json');
+  if (await isFile(outputContract)) {
+    const parsed = parseCkbOutputContract(await readFile(outputContract, 'utf8'), vaultRoot);
+    if (!parsed) throw new Error('CKB 输出契约无效；请用 ckb.py obsidian-plugin deploy 重新投影。');
+    if (!await isFile(path.join(parsed.outputRoot, 'machine', 'knowledge.sqlite'))) {
+      throw new Error('CKB 输出契约指向的 machine/knowledge.sqlite 不存在。');
+    }
+    if (!await isFile(parsed.python) || !await isFile(parsed.ckbScript)) {
+      throw new Error('CKB 输出契约中的 Python 或 ckb.py 不存在。');
+    }
+    return parsed;
+  }
+  const configuredOutput = process.env.CKB_OUTPUT?.trim();
+  const candidates = [configuredOutput, vaultRoot, path.dirname(vaultRoot)]
+    .filter((value): value is string => Boolean(value));
+  let outputRoot = '';
+  for (const candidate of candidates) {
+    if (await isFile(path.join(candidate, 'machine', 'knowledge.sqlite'))) {
+      outputRoot = path.resolve(candidate);
+      break;
+    }
+  }
+  if (!outputRoot) {
+    throw new Error('CKB stdio 未找到 machine/knowledge.sqlite；请打开已完成的 CKB vault。');
+  }
+  const envPython = process.env.CKB_PYTHON?.trim();
+  const envScript = process.env.CKB_SCRIPT?.trim();
+  if (envPython && envScript) {
+    return { ckbScript: envScript, outputRoot, python: envPython };
+  }
+  for (const instruction of [
+    path.join(vaultRoot, 'AGENTS.md'),
+    path.join(outputRoot, 'AGENTS.md'),
+  ]) {
+    if (!await isFile(instruction)) continue;
+    const parsed = parseCkbBinding(await readFile(instruction, 'utf8'), outputRoot);
+    if (parsed && await isFile(parsed.python) && await isFile(parsed.ckbScript)) return parsed;
+  }
+  throw new Error('CKB stdio 未从 AGENTS.md 解析到可执行的 Python 和 ckb.py 绑定。');
+}
+
+export class CkbStdioClient {
+  private binding: CkbStdioBinding | null = null;
+  private child: ChildProcessWithoutNullStreams | null = null;
+  private counter = 0;
+  private pending = new Map<string, PendingRequest>();
+  private reader: Interface | null = null;
+  private startPromise: Promise<void> | null = null;
+  private stderrTail = '';
+
+  constructor(private readonly app: App) {}
+
+  start(): Promise<void> {
+    if (this.startPromise) return this.startPromise;
+    if (this.child) return Promise.resolve();
+    this.startPromise = this.startProcess().finally(() => {
+      this.startPromise = null;
+    });
+    return this.startPromise;
+  }
+
+  async retrieve(question: string): Promise<CkbStdioRetrieval> {
+    await this.start();
+    const requestId = `obsidian-${Date.now()}-${++this.counter}`;
+    const response = await this.send(requestId, {
+      budget: 1800,
+      max_pages: 8,
+      method: 'retrieve',
+      profile: 'fast',
+      question: utf8SafeText(question),
+    }, 60_000);
+    const status = response.status;
+    const pack = response.pack;
+    if (status !== 'passed' || typeof pack !== 'string' || !pack.trim()) {
+      throw new Error('CKB stdio 检索未返回通过的 Agent pack。');
+    }
+    if (!this.binding) throw new Error('CKB stdio 绑定已丢失。');
+    const resolvedPack = path.resolve(pack);
+    const packText = utf8SafeText(await readFile(resolvedPack, 'utf8'));
+    return {
+      elapsedMs: Number(response.elapsed_ms ?? 0),
+      outputRoot: this.binding.outputRoot,
+      pack: resolvedPack,
+      packText,
+      requestId,
+      status: 'passed',
+    };
+  }
+
+  async recordExplanation(input: CkbRecordExplanationInput): Promise<CkbRecordedExplanation> {
+    await this.start();
+    const requestId = `record-${Date.now()}-${++this.counter}`;
+    const response = await this.send(requestId, {
+      explanation: utf8SafeText(input.explanation),
+      idempotency_key: input.idempotencyKey,
+      method: 'record-explanation',
+      pack: input.pack,
+      question: utf8SafeText(input.question),
+      retrieval_request_id: input.retrievalRequestId,
+      selected_text: utf8SafeText(input.selectedText),
+      source_path: input.sourcePath,
+      source_title: input.sourceTitle,
+    }, 120_000);
+    const evidence = response.evidence ?? response.record;
+    const feedbackAudit = response.feedback_audit;
+    const agentPolicyAudit = response.agent_policy_audit;
+    if (
+      response.status !== 'passed'
+      || typeof evidence !== 'string'
+      || typeof feedbackAudit !== 'string'
+      || typeof agentPolicyAudit !== 'string'
+    ) {
+      throw new Error('CKB stdio 没有返回完整的记录与审计凭据。');
+    }
+    return {
+      agentPolicyAudit: path.resolve(agentPolicyAudit),
+      evidence: path.resolve(evidence),
+      feedbackAudit: path.resolve(feedbackAudit),
+      pack: path.resolve(input.pack),
+      retrievalRequestId: input.retrievalRequestId,
+      status: 'passed',
+    };
+  }
+
+  async dispose(): Promise<void> {
+    const child = this.child;
+    if (!child) return;
+    try {
+      await this.send(`shutdown-${Date.now()}`, { method: 'shutdown' }, 1_500);
+    } catch {
+      child.kill();
+    }
+    this.close(new Error('CKB stdio 已关闭。'));
+  }
+
+  private async startProcess(): Promise<void> {
+    this.binding = await discoverBinding(this.app);
+    const child = spawn(
+      this.binding.python,
+      [this.binding.ckbScript, 'serve', '--out', this.binding.outputRoot, '--stdio'],
+      {
+        cwd: this.binding.outputRoot,
+        env: {
+          ...process.env,
+          PYTHONIOENCODING: 'utf-8',
+          PYTHONUTF8: '1',
+        },
+        stdio: ['pipe', 'pipe', 'pipe'],
+        windowsHide: true,
+      },
+    );
+    this.child = child;
+    this.stderrTail = '';
+    child.stderr.setEncoding('utf8');
+    child.stderr.on('data', chunk => {
+      this.stderrTail = `${this.stderrTail}${String(chunk)}`.slice(-4_000);
+    });
+    this.reader = createInterface({ input: child.stdout });
+    this.reader.on('line', line => this.onLine(line));
+    child.once('exit', (code, signal) => {
+      const detail = this.stderrTail.trim();
+      this.close(new Error(`CKB stdio 退出：code=${code}; signal=${signal}; ${detail}`));
+    });
+    child.once('error', error => this.close(error));
+    try {
+      const ping = await this.send(`ping-${Date.now()}`, { method: 'ping' }, 10_000);
+      const methods = Array.isArray(ping.methods) ? ping.methods : [];
+      if (
+        ping.status !== 'ready'
+        || ping.protocol !== 'ckb-stdio-retrieval'
+        || Number(ping.protocol_version ?? 0) < 2
+        || !methods.includes('record-explanation')
+      ) {
+        throw new Error('CKB stdio ping 协议不匹配。');
+      }
+    } catch (error) {
+      child.kill();
+      this.close(error instanceof Error ? error : new Error(String(error)));
+      throw error;
+    }
+  }
+
+  private send(
+    id: string,
+    body: Record<string, unknown>,
+    timeoutMs: number,
+  ): Promise<Record<string, unknown>> {
+    const child = this.child;
+    if (!child?.stdin.writable) return Promise.reject(new Error('CKB stdio 进程未就绪。'));
+    return new Promise((resolve, reject) => {
+      const timer = window.setTimeout(() => {
+        this.pending.delete(id);
+        reject(new Error(`CKB stdio 请求超时：${id}`));
+      }, timeoutMs);
+      this.pending.set(id, { reject, resolve, timer });
+      child.stdin.write(`${JSON.stringify({ id, ...body })}\n`, 'utf8', error => {
+        if (!error) return;
+        const pending = this.pending.get(id);
+        if (!pending) return;
+        window.clearTimeout(pending.timer);
+        this.pending.delete(id);
+        pending.reject(error);
+      });
+    });
+  }
+
+  private onLine(line: string): void {
+    let response: StdioResponse;
+    try {
+      response = JSON.parse(line) as StdioResponse;
+    } catch {
+      return;
+    }
+    const id = String(response.id ?? '');
+    const pending = this.pending.get(id);
+    if (!pending) return;
+    window.clearTimeout(pending.timer);
+    this.pending.delete(id);
+    if (!response.ok || !response.result) {
+      pending.reject(new Error(response.error?.message || 'CKB stdio 返回未知错误。'));
+      return;
+    }
+    const elapsedMs = Number((response as { elapsed_ms?: number }).elapsed_ms ?? 0);
+    pending.resolve({ ...response.result, elapsed_ms: elapsedMs });
+  }
+
+  private close(error: Error): void {
+    this.reader?.close();
+    this.reader = null;
+    this.child = null;
+    for (const pending of this.pending.values()) {
+      window.clearTimeout(pending.timer);
+      pending.reject(error);
+    }
+    this.pending.clear();
+  }
+}
diff --git a/src/features/selection-learning/DailyLearningNoteStore.ts b/src/features/selection-learning/DailyLearningNoteStore.ts
