@@ -0,0 +1,116 @@
+import { ProviderRegistry } from '@/core/providers/ProviderRegistry';
+import type { ProviderChatUIConfig, ProviderId } from '@/core/providers/types';
+import {
+  FOLLOW_DEFAULT_SELECTION_PROVIDER,
+  formatSelectionLearningProviderContext,
+  normalizeSelectionLearningProvider,
+  resolveSelectionLearningProviderContext,
+} from '@/features/selection-learning/SelectionLearningProvider';
+
+interface TestProviderConfig {
+  defaultModel: string;
+  options: string[];
+}
+
+function createUiConfig(config: TestProviderConfig): ProviderChatUIConfig {
+  return {
+    getModelOptions: () => config.options.map(value => ({ label: value, value })),
+    getCustomModelIds: () => new Set(),
+    getDefaultModel: () => config.defaultModel,
+    ownsModel: model => config.options.includes(model),
+    isAdaptiveReasoningModel: () => false,
+    getReasoningOptions: () => [],
+    getDefaultReasoningValue: () => 'off',
+    getContextWindowSize: () => 200_000,
+    isDefaultModel: model => model === config.defaultModel,
+    applyModelDefaults: () => undefined,
+    normalizeAvailableModelSelection: model => model,
+    normalizeModelVariant: model => model,
+  };
+}
+
+describe('selection learning provider resolution', () => {
+  const providers: Record<ProviderId, TestProviderConfig> = {
+    claude: { defaultModel: 'opus', options: ['haiku', 'opus'] },
+    codex: { defaultModel: 'gpt-5.6-sol', options: ['gpt-5.6-sol', 'gpt-5.6-luna'] },
+  };
+
+  beforeEach(() => {
+    jest.spyOn(ProviderRegistry, 'getRegisteredProviderIds')
+      .mockReturnValue(['claude', 'codex']);
+    jest.spyOn(ProviderRegistry, 'getEnabledProviderIds')
+      .mockImplementation(settings => (
+        ((settings.enabledProviders as ProviderId[] | undefined) ?? [])
+      ));
+    jest.spyOn(ProviderRegistry, 'getBlankTabProviderIds')
+      .mockImplementation(settings => (
+        ((settings.enabledProviders as ProviderId[] | undefined) ?? [])
+      ));
+    jest.spyOn(ProviderRegistry, 'isEnabled')
+      .mockImplementation((providerId, settings) => (
+        ((settings.enabledProviders as ProviderId[] | undefined) ?? []).includes(providerId)
+      ));
+    jest.spyOn(ProviderRegistry, 'getChatUIConfig')
+      .mockImplementation(providerId => createUiConfig(providers[providerId ?? 'claude']!));
+    jest.spyOn(ProviderRegistry, 'getProviderDisplayName')
+      .mockImplementation(providerId => providerId === 'codex' ? 'Codex' : 'Claude Code');
+    jest.spyOn(ProviderRegistry, 'resolveSettingsProviderId').mockReturnValue('claude');
+  });
+
+  afterEach(() => {
+    jest.restoreAllMocks();
+  });
+
+  it('follows the provider and model selected as the new-chat default', () => {
+    const settings = {
+      enabledProviders: ['claude', 'codex'],
+      lastSelectedChatModel: { providerId: 'codex', model: 'gpt-5.6-luna' },
+      selectionLearningProvider: FOLLOW_DEFAULT_SELECTION_PROVIDER,
+    };
+
+    expect(resolveSelectionLearningProviderContext(settings)).toEqual({
+      modelOverride: 'gpt-5.6-luna',
+      providerId: 'codex',
+      source: 'default-model',
+    });
+
+    settings.lastSelectedChatModel = { providerId: 'claude', model: 'opus' };
+    expect(resolveSelectionLearningProviderContext(settings)).toEqual({
+      modelOverride: 'opus',
+      providerId: 'claude',
+      source: 'default-model',
+    });
+  });
+
+  it('uses the saved model when the user fixes one Provider', () => {
+    const context = resolveSelectionLearningProviderContext({
+      enabledProviders: ['claude', 'codex'],
+      lastSelectedChatModel: { providerId: 'claude', model: 'opus' },
+      savedProviderModel: { codex: 'gpt-5.6-luna' },
+      selectionLearningProvider: 'codex',
+    });
+
+    expect(context).toEqual({
+      modelOverride: 'gpt-5.6-luna',
+      providerId: 'codex',
+      source: 'fixed-provider',
+    });
+    expect(formatSelectionLearningProviderContext(context)).toBe('Codex / gpt-5.6-luna');
+  });
+
+  it('falls back to follow-default when a fixed Provider is disabled or unknown', () => {
+    const base = {
+      enabledProviders: ['codex'],
+      lastSelectedChatModel: { providerId: 'codex', model: 'gpt-5.6-sol' },
+    };
+
+    expect(normalizeSelectionLearningProvider({
+      ...base,
+      selectionLearningProvider: 'claude',
+    })).toBe(FOLLOW_DEFAULT_SELECTION_PROVIDER);
+    expect(normalizeSelectionLearningProvider({
+      ...base,
+      selectionLearningProvider: 'missing',
+    })).toBe(FOLLOW_DEFAULT_SELECTION_PROVIDER);
+  });
+});
