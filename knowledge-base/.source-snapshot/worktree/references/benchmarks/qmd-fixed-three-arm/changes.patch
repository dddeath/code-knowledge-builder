+def _run_qmd_build_process(
+    protocol: dict[str, Any],
+    documents: list[dict[str, str]],
+    qmd_package: Path,
+    qmd_model: Path,
+    node_executable: Path,
+    qmd_root: Path,
+    qmd_identity: dict[str, Any],
