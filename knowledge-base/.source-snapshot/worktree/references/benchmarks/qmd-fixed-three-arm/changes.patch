+        str(qmd_root / "corpus"),
+        "--collection",
+        collection,
+        "--model",
+        str(qmd_model),
+        "--question-id",
+        question["id"],
+        "--question",
+        question["question"],
+        "--candidate-depth",
+        str(candidate_depth),
+        "--hot-runs",
+        str(hot_runs),
+    ]
+    started = time.perf_counter_ns()
+    process = subprocess.Popen(
+        command,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+        text=True,
