+from __future__ import annotations
+
+import json
+from pathlib import Path
+import subprocess
+import sys
+import unittest
+
+
+REPO = Path(__file__).resolve().parents[1]
+SKILL = REPO / "prototypes" / "ckb-canvas-skill"
+FIXTURE = REPO / "tests" / "fixtures" / "obsidian-canvas-agent-visualization"
